# Suunto API credentials (required for Suunto cloud API access)
SUUNTO_CLIENT_ID=
# Use the OAuth client secret configured in Suunto API Zone.
# If the profile page shows it blank, create/set one there and use the same value here.
SUUNTO_CLIENT_SECRET=
SUUNTO_REDIRECT_URI=http://localhost:8080/callback
SUUNTO_SUBSCRIPTION_KEY=

# API base URLs (defaults shown)
SUUNTO_API_BASE=https://cloudapi.suunto.com
SUUNTO_OAUTH_BASE=https://cloudapi-oauth.suunto.com

# API limit safety. Developer API is currently 10 calls/min and 200 calls/week.
# Set either value to 0 to disable that guard.
SUUNTO_API_CALLS_PER_MINUTE=10
SUUNTO_API_WEEKLY_CALL_LIMIT=200
SUUNTO_API_QUOTA_FILE=.suunto-mcp/api-quota.json

# Token storage: keyring, file, or memory. Keyring is safest for personal desktop use.
SUUNTO_TOKEN_STORE=keyring
# Only needed if TOKEN_STORE=file; keep it under a gitignored directory.
# SUUNTO_TOKEN_FILE=.suunto-mcp/tokens.json

# Default account for multi-user mode when account_id is omitted
# SUUNTO_DEFAULT_ACCOUNT_ID=

# Local data / no-key mode
SUUNTO_LOCAL_DATA_DIR=.suunto-mcp/data
# Export directory for binary outputs
SUUNTO_EXPORT_DIR=.suunto-mcp/exports
# Max base64 inline payload size in bytes (default 5MB)
# SUUNTO_MAX_BASE64_BYTES=5000000

# MCP HTTP transport bearer token (required if using HTTP transport beyond localhost)
# SUUNTO_MCP_API_TOKEN=

# Webhook configuration
# SUUNTO_WEBHOOK_SECRET=
# SUUNTO_WEBHOOK_STORE=jsonl
# SUUNTO_WEBHOOK_STORE_PATH=.suunto-mcp/webhooks.jsonl

# Safety: must be true to enable write/push tools
# SUUNTO_ENABLE_WRITE_TOOLS=false

# Dev/live tests: disabled by default to protect API limits
# SUUNTO_LIVE_TESTS=false
# SUUNTO_LIVE_TOKEN_FILE=.suunto-mcp/oauth-test-token.json
